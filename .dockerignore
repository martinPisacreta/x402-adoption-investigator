# Never bake secrets or runtime state into the image.
.env
.env.local
.env.*
!.env.example
*.local
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
**/wallet*.json
**/cookies*
logs/*
!logs/.gitkeep
memory/state/*
!memory/state/.gitkeep
.git
.gitignore
__pycache__/
*.pyc
.pytest_cache/
.venv/
scratch/
.vscode/
.idea/
