# x402 Adoption Investigator - environment variables
# Copy to .env.local or .env (both gitignored; .env.local wins over .env, the shell over both). Sample mode needs
# NONE of these: without an env file the run is offline. Note: a copy of this file as it is sets METERLESS_BASE_URL,
# which makes the default --mode auto run live (see "Mode" below); --sample or SAMPLE_MODE=1 keeps it offline.
# Never commit real values. The code never prints or logs them (names only are reported).

# --- Generator, primary: Meterless Nightshift (Meterless Runtime, OpenAI-compatible provider "meterless")
# Used by the Planner, the Writer and the Critic's second opinion in live mode. Each comment is on its own line
# (the loader also drops a ` # ...` after an unquoted value; quote a value that contains ` #`). Names are the hackathon guides' (METERLESS_*); each NIGHTSHIFT_* twin
# (NIGHTSHIFT_BASE_URL, NIGHTSHIFT_TOKEN, NIGHTSHIFT_MODEL) wins over it when both are set.
# Base URL of the runtime. Unset: live mode auto-detects it (GET /v1/models on ports 8088, 8090, 8787, 11434 of
# 127.0.0.1, localhost and [::1]). Any pasted form works: host:port, .../v1, .../v1/models, .../healthz.
# Inside Docker 127.0.0.1 is the container itself: the host's runtime is http://host.docker.internal:8088/v1. The
# investigator-live service of docker-compose.yml sets that (and mounts the proxy-token file read-only), overriding
# this value; a plain `docker run --env-file` needs it here.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime token. Leave it empty on the machine that runs Nightshift: the token is then read from the file the
# runtime writes, <stateDir>/proxy-token, where stateDir is METERLESS_STATE_DIR or the default the official ns CLI
# uses: %LOCALAPPDATA%\ai.meterless.runtime (Windows), ~/Library/Application Support/ai.meterless.runtime (macOS),
# /var/lib/meterless (Linux). In Docker there is no such file: set the token here or mount the file and point
# NIGHTSHIFT_TOKEN_FILE at it. Lookup order: NIGHTSHIFT_TOKEN, METERLESS_RUNTIME_TOKEN, METERLESS_TOKEN,
# NIGHTSHIFT_TOKEN_FILE, <stateDir>/proxy-token. The placeholder rt-local is rejected. Never commit a real token.
METERLESS_RUNTIME_TOKEN=
# NIGHTSHIFT_TOKEN_FILE=/run/secrets/proxy-token
# METERLESS_STATE_DIR=
# Model: a routing mode (meterless/auto | fast | deep | cheap | local | fusion | meterless/<class>[.<disposition>]) or a
# concrete model id, which pins the route so every receipt names the model that answered.
# Portable default (any Nightshift, whatever lanes it has; the receipts then name the model it picked):
METERLESS_MODEL=meterless/auto
# Recommended, and what the committed transcripts and live traces use: NVIDIA Nemotron 3.5 Lightning 30B A3B on
# NVIDIA's hosted API (no GPU needed). The NVIDIA API key goes in Nightshift's Setup > Providers, never in this file.
# METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# The local Nemotron lane of the demo machine's Nightshift fleet (Nemotron Nano 9B v2 GGUF on the GPU):
# METERLESS_MODEL=local-runtime/nvidia-nvidia-nemotron-nano-9b-v2-q4-k-m
# Thinking switch of every Nightshift request (NIGHTSHIFT_REASONING_EFFORT wins over this name). Unset or none: thinking
# off (reasoning_effort "none" plus a /no_think system turn), so a reasoning model such as Nemotron answers inside each
# role's token budget. default: send no thinking control. minimal | low | medium | high | xhigh: sent as reasoning_effort.
# METERLESS_REASONING_EFFORT=none
# Do not probe localhost when no base URL is set:
# NIGHTSHIFT_AUTODETECT=0

# --- Generator, FALLBACK only: any OpenAI-compatible chat-completions endpoint, used only when Nightshift is not
# online (the run logs recovery{nightshift_unavailable} with the reason). With neither, the generator-backed roles
# fall back to rules and templates (recovery{generator_fallback}).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1-mini

# --- Zetaris (local Docker instance; UI/REST proxy). Org id is read from the login response when empty.
# ZETARIS_USERNAME / ZETARIS_PASSWORD are the platform admin login (ZETARIS_ADMIN_EMAIL / ZETARIS_ADMIN_PASSWORD
# in the zetaris-platform .env). Without them live mode runs the same SQL on SQLite (recovery{zetaris_unreachable}).
# ZETARIS_REST_URL (the hackathon guides' name) is accepted as an alias; ZETARIS_BASE_URL wins when both are set.
# Inside Docker use http://host.docker.internal:3000 (the investigator-live compose service sets it).
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=
# Optional alternatives (each comment on its own line, above the variable it describes)
# GUI-created API key; the login JWT is enough on 2.4.3.1:
# ZETARIS_API_KEY=
# proxy (http://localhost:3000/api/proxy/...) | direct (http://localhost:8888/api/v1.0/...):
# ZETARIS_API_STYLE=proxy
# How the Zetaris driver container reaches this machine:
# ARTIFACT_SERVER_HOST=host.docker.internal
# 0 = random free port; in Docker a fixed, published port (compose: 18765):
# ARTIFACT_SERVER_PORT=0

# --- Mode
# Default (unset): auto = sample when none of METERLESS_BASE_URL / NIGHTSHIFT_BASE_URL, METERLESS_RUNTIME_TOKEN /
# METERLESS_TOKEN / NIGHTSHIFT_TOKEN, NIGHTSHIFT_TOKEN_FILE, OPENAI_API_KEY and ZETARIS_PASSWORD is set, live
# otherwise (deciding the mode never touches the network; the runtime's proxy-token file alone does not count).
# So a copy of this file with METERLESS_BASE_URL set runs live; --mode sample (or SAMPLE_MODE=1) stays offline.
# Set to 1 (or true) to force sample mode (fixtures only, network guard installed, no model calls) even with
# credentials; empty = the rule above:
SAMPLE_MODE=

# --- Optional
# Live-mode persistent H-MEM store (gitignored):
# HMEM_DIR=memory/state
# LOG_DIR=logs
