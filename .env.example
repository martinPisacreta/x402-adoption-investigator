# x402 Adoption Investigator - environment variables
# Copy to .env.local (gitignored). Sample mode needs NONE of these: without this file the run is offline.
# Never commit real values. The code never prints or logs them (names only are reported).

# --- Generator, primary: Meterless Nightshift (Meterless Runtime, OpenAI-compatible provider "meterless")
# Used by the Planner, the Writer and the Critic's second opinion in live mode. Values take no inline comments:
# each comment is on its own line. Names are the hackathon guides' (METERLESS_*); each NIGHTSHIFT_* twin
# (NIGHTSHIFT_BASE_URL, NIGHTSHIFT_TOKEN, NIGHTSHIFT_MODEL) wins over it when both are set.
# Base URL of the runtime. Unset: live mode auto-detects it (GET /v1/models on ports 8088, 8090, 8787, 11434 of
# 127.0.0.1, localhost and [::1]). Any pasted form works: host:port, .../v1, .../v1/models, .../healthz.
# Inside Docker the host's runtime is http://host.docker.internal:8088/v1 (docker-compose.yml maps the name).
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# Runtime token. Leave it empty on the machine that runs Nightshift: the token is then read from the file the
# runtime writes, <stateDir>/proxy-token, where stateDir is METERLESS_STATE_DIR or the default the official ns CLI
# uses: %LOCALAPPDATA%\ai.meterless.runtime (Windows), ~/Library/Application Support/ai.meterless.runtime (macOS),
# /var/lib/meterless (Linux). In Docker there is no such file: set the token here or mount the file and point
# NIGHTSHIFT_TOKEN_FILE at it. Lookup order: NIGHTSHIFT_TOKEN, METERLESS_RUNTIME_TOKEN, METERLESS_TOKEN,
# NIGHTSHIFT_TOKEN_FILE, <stateDir>/proxy-token. The placeholder rt-local is rejected. Never commit a real token.
METERLESS_RUNTIME_TOKEN=
# NIGHTSHIFT_TOKEN_FILE=/run/secrets/proxy-token
# METERLESS_STATE_DIR=
# Routing mode (not a model file): meterless/auto | fast | deep | cheap | local | fusion | meterless/<class>[.<disposition>]
METERLESS_MODEL=meterless/auto
# Do not probe localhost when no base URL is set:
# NIGHTSHIFT_AUTODETECT=0

# --- Generator, FALLBACK only: any OpenAI-compatible chat-completions endpoint, used only when Nightshift is not
# online (the run logs recovery{nightshift_unavailable} with the reason). With neither, the generator-backed roles
# fall back to rules and templates (recovery{generator_fallback}).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4.1-mini

# --- Zetaris (local Docker instance; UI/REST proxy). Org id is read from the login response when empty.
# ZETARIS_USERNAME / ZETARIS_PASSWORD are the platform admin login (ZETARIS_ADMIN_EMAIL / ZETARIS_ADMIN_PASSWORD
# in the zetaris-platform .env). Without them live mode runs the same SQL on SQLite (recovery{zetaris_unreachable}).
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=
# Optional alternatives
# ZETARIS_API_KEY=            # GUI-created API key; the login JWT is enough on 2.4.3.1
# ZETARIS_API_STYLE=proxy     # proxy (http://localhost:3000/api/proxy/...) | direct (http://localhost:8888/api/v1.0/...)
# ARTIFACT_SERVER_HOST=host.docker.internal   # how the Zetaris driver container reaches this machine
# ARTIFACT_SERVER_PORT=0      # 0 = random free port

# --- Mode
# Default (unset): auto = sample when none of METERLESS_BASE_URL / NIGHTSHIFT_BASE_URL, METERLESS_RUNTIME_TOKEN /
# METERLESS_TOKEN / NIGHTSHIFT_TOKEN, NIGHTSHIFT_TOKEN_FILE, OPENAI_API_KEY and ZETARIS_PASSWORD is set, live
# otherwise (deciding the mode never touches the network; the runtime's proxy-token file alone does not count).
# So a copy of this file with METERLESS_BASE_URL set runs live; --mode sample (or SAMPLE_MODE=1) stays offline.
# Uncomment to force sample mode (fixtures only, network guard installed, no model calls) even with credentials:
# SAMPLE_MODE=1

# --- Optional
# HMEM_DIR=memory/state       # live-mode persistent H-MEM store (gitignored)
# LOG_DIR=logs
