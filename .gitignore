# secrets (only .env.example is committed)
.env
.env.local
.env.*
!.env.example
*.local
*.pem
*.key
*.p12
*.pfx
auth.json
wallet*.json
cookies*

# runtime logs (keep the folder)
logs/*
!logs/.gitkeep

# live-mode persistent memory (sample mode uses memory/seed, committed)
memory/state/*
!memory/state/.gitkeep

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# per-run sqlite + tracebacks live under logs/ (already ignored)

# scratch
scratch/
