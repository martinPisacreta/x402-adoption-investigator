{"seq":33,"query_id":"q16_settlements_vs_receipts","executor":"sqlite","sql":"SELECT st.tx_hash, st.payer AS chain_payer, s.payer AS receipt_payer, st.seller AS chain_seller, s.seller AS receipt_seller, st.amount_atomic AS chain_amount, s.amount_atomic AS receipt_amount, CASE WHEN LOWER(st.payer) = LOWER(s.payer) THEN 1 ELSE 0 END AS payer_match, CASE WHEN LOWER(st.seller) = LOWER(s.seller) THEN 1 ELSE 0 END AS seller_match, CASE WHEN st.amount_atomic = s.amount_atomic THEN 1 ELSE 0 END AS amount_match, st.status FROM settlements st INNER JOIN sales s ON LOWER(st.tx_hash) = LOWER(s.tx_hash) ORDER BY st.tx_hash","sql_sha256":"82a4f8cbe2abce1bb339803cda230200231eeae43845ed91fc3c6e2261ef3815","params":{},"headers":["tx_hash","chain_payer","receipt_payer","chain_seller","receipt_seller","chain_amount","receipt_amount","payer_match","seller_match","amount_match","status"],"rowcount":1,"rows":[["0x62c01526c5beb13cad96634ec80e837e576df496905f1bac8019c6ffa3e358c3","0x097e3f339d0b023605e12a6b81e2d6cb7571475a","0x097e3f339d0b023605e12a6b81e2d6cb7571475a","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1",1000,1000,1,1,1,"verified"]],"time_used_ms":1,"zetaris_version":null,"fallback_reason":null,"tables":[{"name":"sales","source_url":"logs/ex04-unverified/exports/store_receipts.json"},{"name":"purchases","source_url":"logs/ex04-unverified/exports/store_receipts.json"},{"name":"bazaar_resources","source_url":null},{"name":"bazaar_search","source_url":"logs/ex04-unverified/exports/cdp_search_host.json"},{"name":"catalog_resources","source_url":null},{"name":"openapi_paid_ops","source_url":null},{"name":"agent402_tools","source_url":null},{"name":"agent402_seller","source_url":null},{"name":"vet402_endpoints","source_url":null},{"name":"trust_search","source_url":null},{"name":"trust_stats","source_url":null},{"name":"settlements","source_url":"logs/ex04-unverified/exports/settlements.json"},{"name":"chain_facts","source_url":null}]}
