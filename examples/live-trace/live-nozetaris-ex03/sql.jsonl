{"seq":32,"query_id":"q16_settlements_vs_receipts","executor":"sqlite","sql":"SELECT st.tx_hash, st.payer AS chain_payer, s.payer AS receipt_payer, st.seller AS chain_seller, s.seller AS receipt_seller, st.amount_atomic AS chain_amount, s.amount_atomic AS receipt_amount, CASE WHEN LOWER(st.payer) = LOWER(s.payer) THEN 1 ELSE 0 END AS payer_match, CASE WHEN LOWER(st.seller) = LOWER(s.seller) THEN 1 ELSE 0 END AS seller_match, CASE WHEN st.amount_atomic = s.amount_atomic THEN 1 ELSE 0 END AS amount_match, st.status FROM settlements st INNER JOIN sales s ON LOWER(st.tx_hash) = LOWER(s.tx_hash) ORDER BY st.tx_hash","sql_sha256":"82a4f8cbe2abce1bb339803cda230200231eeae43845ed91fc3c6e2261ef3815","params":{},"headers":["tx_hash","chain_payer","receipt_payer","chain_seller","receipt_seller","chain_amount","receipt_amount","payer_match","seller_match","amount_match","status"],"rowcount":4,"rows":[["0x068b1930266c6235ee31cbfa87690b8ef14c519bba4f1dafd0b36872b836fe95","0xec2abd3eda89bed90124736e317e847d5fb6d034","0xec2abd3eda89bed90124736e317e847d5fb6d034","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1",2000,2000,1,1,1,"verified"],["0x3ca4f2791f4f851a574f4abd7cb949e1b05fb00dadeb77b83fb3d0e36a608fb2","0xc9c7b38c0942914fc8ea12063bc92dcd3b581670","0xc9c7b38c0942914fc8ea12063bc92dcd3b581670","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1",1000,1000,1,1,1,"verified"],["0x58ddb2e77e574ddda75fd74df6f3dbf94e2795e22c36f8a01a506c544ff4ada3","0xa1d1c0cf717402ff3651aa4873ccf96410b01978","0xa1d1c0cf717402ff3651aa4873ccf96410b01978","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1",1000,1000,1,1,1,"verified"],["0x62c01526c5beb13cad96634ec80e837e576df496905f1bac8019c6ffa3e358c3","0x097e3f339d0b023605e12a6b81e2d6cb7571475a","0x097e3f339d0b023605e12a6b81e2d6cb7571475a","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1","0x6b5af9924f4cd35643c11a9fd1c983f77261a6e1",1000,1000,1,1,1