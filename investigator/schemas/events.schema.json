{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pisacretamartin/x402-adoption-investigator/investigator/schemas/events.schema.json",
  "title": "run.jsonl line",
  "description": "One line of logs/<run_id>/run.jsonl (mirrored to stdout). The required payload keys per event type are listed under $defs/payloads and asserted by tests/test_run_contract.py. SPEC.md section 5.",
  "type": "object",
  "required": ["seq", "at", "run_id", "type", "agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "type": { "$ref": "#/$defs/event_type" },
    "agent": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "$defs": {
    "event_type": {
      "enum": ["guard", "run_start", "plan", "handoff", "fetch", "retry", "recovery", "ingest", "verify", "crosscheck", "sql", "claim", "conflict", "critique", "narrative_map", "memory", "timeout", "result", "error"]
    },
    "recovery_reason": {
      "enum": ["planner_fallback", "fixture_fallback", "source_unavailable", "fixture_miss", "zetaris_unreachable", "zetaris_query_fallback", "artifact_server_unreachable", "rpc_unavailable", "generator_fallback", "narrative_trimmed", "deadline_skip", "budget_exhausted"]
    },
    "payloads": {
      "guard": { "type": "object", "required": ["network", "patched"], "properties": { "network": { "const": "disabled" }, "patched": { "type": "array", "items": { "type": "string" } } } },
      "run_start": { "type": "object", "required": ["mounts", "input_sha256", "budget", "deadline_at"] },
      "plan": { "type": "object", "required": ["playbook", "query_ids", "sources", "fetch_count", "hmem_memory_ids", "planner_source"] },
      "handoff": { "type": "object", "required": ["from", "to", "artifact"], "properties": { "artifact": { "type": "object", "required": ["type", "count", "sha256"] } } },
      "fetch": { "type": "object", "required": ["name", "family", "url", "method", "http", "bytes", "sha256", "latency_ms", "replayed", "stale"] },
      "retry": { "type": "object", "required": ["target", "attempt", "max_attempts", "reason", "backoff_ms"] },
      "recovery": { "type": "object", "required": ["reason", "detail"], "properties": { "reason": { "$ref": "#/$defs/recovery_reason" } } },
      "ingest": { "type": "object", "required": ["pass", "report", "quarantined"] },
      "verify": { "type": "object", "required": ["tx", "status", "payer", "seller", "amount_atomic", "basescan_url", "receipt_match"] },
      "crosscheck": { "type": "object", "required": ["name", "a", "b", "agree", "note"] },
      "sql": { "type": "object", "required": ["query_id", "executor", "sql_sha256", "params", "rowcount", "time_used_ms"] },
      "claim": { "type": "object", "required": ["claim_id", "metric", "subject", "value", "unit", "backend", "cross_checked", "caveats"] },
      "conflict": { "type": "object", "required": ["conflict_id", "predicate", "subject", "values", "explanation"] },
      "critique": { "type": "object", "required": ["round", "rule", "verdict"] },
      "narrative_map": { "type": "object", "required": ["round", "tokens", "unsourced"] },
      "memory": { "type": "object", "required": ["op", "actor", "memory_ids", "details"], "properties": { "op": { "enum": ["retrieve", "feedback", "mine", "sleep_preview"] } } },
      "timeout": { "type": "object", "required": ["stage", "elapsed_s", "budget_s"] },
      "result": { "type": "object", "required": ["status", "accepted", "rejected", "conflicts", "unavailable", "executor", "generator"] },
      "error": { "type": "object", "required": ["code", "stage", "message", "retryable", "details"] }
    }
  }
}
