{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinPisacreta/x402-adoption-investigator/investigator/schemas/events.schema.json",
  "title": "run.jsonl line",
  "description": "One line of logs/<run_id>/run.jsonl (mirrored to stdout). The required payload keys per event type are listed under $defs/payloads and asserted by tests/test_run_contract.py. SPEC.md section 5.",
  "type": "object",
  "required": ["seq", "at", "run_id", "type", "agent", "payload"],
  "additionalProperties": false,
  "properties": {
    "seq": { "type": "integer", "minimum": 1 },
    "at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "type": { "$ref": "#/$defs/event_type" },
    "agent": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  },
  "$defs": {
    "event_type": {
      "enum": ["guard", "run_start", "plan", "handoff", "fetch", "retry", "recovery", "ingest", "verify", "crosscheck", "sql", "claim", "conflict", "critique", "narrative_map", "memory", "generate", "timeout", "result", "error"]
    },
    "recovery_reason": {
      "enum": ["planner_fallback", "fixture_fallback", "source_unavailable", "fixture_miss", "zetaris_unreachable", "zetaris_query_fallback", "artifact_server_unreachable", "rpc_unavailable", "generator_fallback", "nightshift_unavailable", "narrative_trimmed", "deadline_skip", "budget_exhausted"]
    },
    "payloads": {
      "guard": { "type": "object", "required": ["network", "patched"], "properties": { "network": { "const": "disabled" }, "patched": { "type": "array", "items": { "type": "string" } } } },
      "run_start": { "type": "object", "required": ["mounts", "input_sha256", "budget", "deadline_at"] },
      "plan": { "type": "object", "required": ["playbook", "query_ids", "sources", "fetch_count", "hmem_memory_ids", "planner_source"] },
      "handoff": { "type": "object", "required": ["from", "to", "artifact"], "properties": { "artifact": { "type": "object", "required": ["type", "count", "sha256"] } } },
      "fetch": { "type": "object", "required": ["name", "family", "url", "method", "http", "bytes", "sha256", "latency_ms", "replayed", "stale"], "properties": { "attempts": { "type": "integer", "minimum": 2, "description": "Present only when the request needed more than one attempt (sources/retry.py)." } } },
      "retry": { "type": "object", "description": "One line per retry, written before the backoff. attempt = the attempt that failed; the next fetch line of the same request_key is the outcome.", "required": ["stage", "target", "attempt", "max_attempts", "reason", "backoff_ms"], "properties": { "stage": { "type": "string", "minLength": 1 }, "target": { "type": "string", "minLength": 1, "description": "request key of a source request, or planner" }, "url": { "type": "string" }, "method": { "type": "string" }, "attempt": { "type": "integer", "minimum": 1 }, "next_attempt": { "type": "integer", "minimum": 2 }, "max_attempts": { "type": "integer", "minimum": 2 }, "reason": { "type": "string", "minLength": 1 }, "kind": { "enum": ["http", "timeout", "connection", "other"] }, "http": { "type": ["integer", "null"] }, "backoff_ms": { "type": "integer", "minimum": 0 }, "replayed": { "type": "boolean", "description": "true when the failed attempt was replayed from a fault script in sample mode" }, "fault_file": { "type": "string", "pattern": "^fixtures/transient/" } } },
      "recovery": { "type": "object", "required": ["reason", "detail"], "properties": { "reason": { "$ref": "#/$defs/recovery_reason" } } },
      "ingest": { "type": "object", "required": ["pass", "report", "quarantined"] },
      "verify": { "type": "object", "required": ["tx", "status", "payer", "seller", "amount_atomic", "basescan_url", "receipt_match"] },
      "crosscheck": { "type": "object", "required": ["name", "a", "b", "agree", "note"] },
      "sql": { "type": "object", "required": ["query_id", "executor", "sql_sha256", "params", "rowcount", "time_used_ms"] },
      "claim": { "type": "object", "required": ["claim_id", "metric", "subject", "value", "unit", "backend", "cross_checked", "caveats"] },
      "conflict": { "type": "object", "required": ["conflict_id", "predicate", "subject", "values", "explanation"] },
      "critique": { "type": "object", "required": ["round", "rule", "verdict"] },
      "narrative_map": { "type": "object", "required": ["round", "tokens", "unsourced"] },
      "memory": { "type": "object", "required": ["op", "actor", "memory_ids", "details"], "properties": { "op": { "enum": ["retrieve", "inject", "feedback", "mine", "sleep_preview"] } } },
      "generate": { "type": "object", "description": "One line per answered generator call (the agent is the role); generator.jsonl repeats its seq with the call parameters and the transcript path. provider: meterless (Nightshift) | openai | the recorded call's provider; requested_model: the routing mode or model asked for; model: the model that answered (response model field, else the requested one).", "required": ["prompt_id", "attempt", "generator", "provider", "requested_model", "model", "recorded", "prompt_sha256", "response_sha256"], "properties": { "prompt_id": { "type": "string", "minLength": 1 }, "attempt": { "type": "integer", "minimum": 1 }, "generator": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "requested_model": { "type": ["string", "null"] }, "model": { "type": "string", "minLength": 1 }, "recorded": { "type": "boolean" }, "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
      "timeout": { "type": "object", "required": ["stage", "elapsed_s", "budget_s"] },
      "result": { "type": "object", "required": ["status", "accepted", "rejected", "conflicts", "unavailable", "executor", "generator"] },
      "error": { "type": "object", "required": ["code", "stage", "message", "retryable", "details"] }
    }
  }
}
