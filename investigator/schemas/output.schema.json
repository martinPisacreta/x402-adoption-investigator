{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martinPisacreta/x402-adoption-investigator/investigator/schemas/output.schema.json",
  "title": "run.py output",
  "description": "Envelope returned by run.py: {run_id, status, output} on ok/partial, {run_id, status: error, error} otherwise. Key order of output is the order of properties below (SPEC.md sections 4.3 and 4.4).",
  "type": "object",
  "required": ["run_id", "status"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "status": { "enum": ["ok", "partial", "error"] },
    "output": { "$ref": "#/$defs/output" },
    "error": { "$ref": "#/$defs/error" }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": ["mounts", "question", "plan", "verdict", "answer", "claims", "rejected_claims", "conflicts", "unavailable", "sources", "verifications", "world", "memory", "agents", "critique_rounds", "report_path", "log_files"],
      "additionalProperties": false,
      "properties": {
        "mounts": { "$ref": "#/$defs/mounts" },
        "sample_mode_notice": { "type": "string", "description": "Present only in sample mode." },
        "scaffold_notice": { "type": "string", "description": "Present only while agent stubs are in place; disappears once every agent is implemented." },
        "question": { "type": "string" },
        "plan": {
          "type": "object",
          "required": ["playbook", "query_ids", "sources", "planner_source"],
          "properties": {
            "playbook": { "enum": ["seller_profile", "catalog_concentration", "payer_dossier"] },
            "query_ids": { "type": "array", "items": { "type": "string" } },
            "sources": { "type": "array", "items": { "type": "string" } },
            "planner_source": { "enum": ["rules", "generator", "recorded-generator"] }
          }
        },
        "verdict": { "$ref": "#/$defs/verdict" },
        "answer": { "type": "string" },
        "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "rejected_claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
        "unavailable": { "type": "array", "items": { "type": "object", "required": ["metric", "reason"] } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "verifications": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "world": {
          "type": "object",
          "required": ["first_pass", "second_pass", "quarantined", "claims_asserted"],
          "properties": {
            "first_pass": { "type": ["object", "null"] },
            "second_pass": { "type": ["object", "null"] },
            "quarantined": { "type": "integer" },
            "claims_asserted": { "type": "integer" }
          }
        },
        "memory": {
          "type": "object",
          "required": ["retrieved", "cited", "feedback", "mined"],
          "properties": {
            "retrieved": { "type": "array" },
            "cited": { "type": "array", "items": { "type": "string" } },
            "feedback": { "type": "array" },
            "mined": { "type": "integer" }
          }
        },
        "agents": { "type": "array", "items": { "$ref": "#/$defs/agent_summary" } },
        "critique_rounds": { "type": "integer", "minimum": 0 },
        "report_path": { "type": "string" },
        "log_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "mounts": {
      "type": "object",
      "required": ["mode", "fetcher", "executor", "generator", "fixtures_captured_at", "zetaris_version", "zetaris_source"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["sample", "live"] },
        "fetcher": { "enum": ["live", "fixture", "live+fixture-fallback"] },
        "executor": { "enum": ["zetaris", "sqlite"] },
        "generator": { "type": "string" },
        "fixtures_captured_at": { "type": ["string", "null"] },
        "zetaris_version": { "type": ["string", "null"] },
        "zetaris_source": { "enum": ["captured", "direct", null] }
      }
    },
    "verdict": {
      "type": "object",
      "required": ["label", "confidence", "why"],
      "properties": {
        "label": { "enum": ["adoption_real", "adoption_thin", "self_settled_mostly", "concentrated", "diffuse", "insufficient_evidence"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "why": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["url", "tx", "log_line"] },
        "ref": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "captured_at": { "type": ["string", "null"] },
        "replayed": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "http": { "type": ["integer", "null"] },
        "verified": { "type": ["boolean", "null"] },
        "fixture_file": { "type": ["string", "null"] }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["items_seen", "total_reported", "share", "basis"],
      "properties": {
        "items_seen": { "type": "integer" },
        "total_reported": { "type": ["integer", "null"] },
        "share": { "type": ["number", "null"] },
        "basis": { "type": "string" }
      }
    },
    "derivation": {
      "type": "object",
      "required": ["agent", "query_id", "sql_sha256", "backend", "reducer", "rows", "fields", "sources", "log_seq"],
      "properties": {
        "agent": { "enum": ["analyst", "verifier"] },
        "query_id": { "type": ["string", "null"] },
        "sql_sha256": { "type": ["string", "null"] },
        "backend": { "enum": ["zetaris", "sqlite", "sqlite-fallback", null] },
        "reducer": { "type": ["string", "null"] },
        "rows": { "type": "integer" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "type": "string" } },
        "log_seq": { "type": ["integer", "null"] }
      }
    },
    "critique": {
      "type": "object",
      "required": ["round", "rule", "verdict", "reason", "memory_ids"],
      "properties": {
        "round": { "type": "integer" },
        "rule": { "type": "string" },
        "verdict": { "enum": ["accept", "reject", "revise"] },
        "reason": { "type": "string" },
        "memory_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim": {
      "type": "object",
      "required": ["id", "metric", "subject", "statement", "value", "unit", "period", "evidence", "derivation", "coverage", "caveats", "caveat_memory_ids", "conflict_ids", "confidence", "status", "cross_checked", "critique"],
      "properties": {
        "id": { "type": "string", "pattern": "^c[0-9]{2,}$" },
        "metric": { "type": "string" },
        "subject": { "type": "string" },
        "statement": { "type": "string" },
        "value": {},
        "unit": { "enum": ["count", "atomic_usdc", "share", "iso8601", "text"] },
        "period": { "type": ["string", "null"] },
        "evidence": { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/evidence" } },
        "derivation": { "anyOf": [ { "$ref": "#/$defs/derivation" }, { "type": "null" } ] },
        "coverage": { "anyOf": [ { "$ref": "#/$defs/coverage" }, { "type": "null" } ] },
        "caveats": { "type": "array", "items": { "type": "string" } },
        "caveat_memory_ids": { "type": "object" },
        "conflict_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "enum": ["proposed", "accepted", "rejected", "revised"] },
        "cross_checked": { "type": "boolean" },
        "critique": { "type": "array", "items": { "$ref": "#/$defs/critique" } }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["id", "predicate", "subject", "values", "explanation", "status", "claim_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^k[0-9]{2,}$" },
        "predicate": { "type": "string" },
        "subject": { "type": "string" },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["source", "value", "url", "basis"],
            "properties": {
              "source": { "type": "string" },
              "value": {},
              "url": { "type": "string" },
              "basis": { "type": "string" },
              "captured_at": { "type": ["string", "null"] }
            }
          }
        },
        "explanation": { "type": "string" },
        "status": { "enum": ["open", "explained", "resolved"] },
        "claim_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "source": {
      "type": "object",
      "required": ["name", "family", "url", "status", "http", "sha256", "captured_at", "replayed", "stale"],
      "properties": {
        "name": { "type": "string" },
        "family": { "type": "string" },
        "url": { "type": "string" },
        "status": { "enum": ["ok", "unavailable", "fixture_miss"] },
        "http": { "type": ["integer", "null"] },
        "sha256": { "type": ["string", "null"] },
        "captured_at": { "type": ["string", "null"] },
        "replayed": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "error": { "type": ["string", "null"] },
        "fixture_file": { "type": ["string", "null"] }
      }
    },
    "verification": {
      "type": "object",
      "required": ["tx", "status", "payer", "seller", "amount_atomic", "block", "block_time", "facilitator_from", "basescan_url", "decoded_from", "receipt_match", "reason"],
      "properties": {
        "tx": { "type": "string" },
        "status": { "enum": ["verified", "failed", "unverifiable"] },
        "payer": { "type": ["string", "null"] },
        "seller": { "type": ["string", "null"] },
        "amount_atomic": { "type": ["integer", "null"] },
        "block": { "type": ["integer", "null"] },
        "block_time": { "type": ["string", "null"] },
        "facilitator_from": { "type": ["string", "null"] },
        "basescan_url": { "type": "string" },
        "decoded_from": { "type": "string" },
        "receipt_match": { "type": ["boolean", "null"] },
        "reason": { "type": ["string", "null"] }
      }
    },
    "agent_summary": {
      "type": "object",
      "required": ["role", "generator_backed", "generator_used", "attempts", "status"],
      "properties": {
        "role": { "type": "string" },
        "generator_backed": { "type": "boolean" },
        "generator_used": { "type": ["string", "null"] },
        "attempts": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["ok", "degraded", "failed"] },
        "notes": { "type": "array", "items": { "type": "string" } },
        "generator_calls": {
          "type": "array",
          "description": "Generator-backed roles: one item per answered call, in order (which model handled each request).",
          "items": {
            "type": "object",
            "required": ["prompt_id", "provider", "model", "recorded"],
            "properties": {
              "prompt_id": { "type": "string" },
              "provider": { "type": "string" },
              "requested_model": { "type": ["string", "null"] },
              "model": { "type": "string" },
              "route": { "type": ["string", "null"] },
              "route_kind": { "type": ["string", "null"] },
              "receipt_id": { "type": ["string", "null"] },
              "recorded": { "type": "boolean" },
              "log_seq": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["code", "stage", "message", "retryable", "details"],
      "properties": {
        "code": { "enum": ["E_INPUT", "E_TIMEOUT", "E_NO_SOURCES", "E_GENERATOR", "E_ZETARIS_REQUIRED", "E_INTERNAL"] },
        "stage": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
